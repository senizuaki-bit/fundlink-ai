# Optional server-only model configuration. Keep actual keys out of Git.
# DeepSeek takes precedence when both providers are configured.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional public news search. Direct public URL imports do not require this.
BRAVE_SEARCH_API_KEY=
